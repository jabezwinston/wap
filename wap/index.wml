<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.3//EN"
  "http://www.wapforum.org/DTD/wml13.dtd">

<!-- WAP Browser demo deck. Every card here is plain WML 1.3. -->
<wml>
  <card id="home" title="WAP Browser demo">
    <p align="center">
      <img src="logo.wbmp" alt="WAP Browser"/><br/>
      <b>Welcome!</b>
    </p>
    <p>
      This little site is written in WML, the language of the mobile web
      before smartphones. Pick a card:
    </p>
    <p>
      <a href="#tip" accesskey="1">Tip calculator</a><br/>
      <a href="#quiz" accesskey="2">WAP quiz</a><br/>
      <a href="#timer" accesskey="3">Countdown</a><br/>
      <a href="#about" accesskey="4">About WAP</a>
    </p>
  </card>

  <!-- WMLScript: tip.wmls reads these variables and writes the result. -->
  <card id="tip" title="Tip calculator">
    <do type="accept" label="Calculate">
      <go href="tip.wmls#calc()"/>
    </do>
    <p>
      Bill amount:<br/>
      <input name="bill" format="*N" value="40" title="Bill"/>
      Tip:<br/>
      <select name="pct" value="15" title="Tip">
        <option value="10">10%</option>
        <option value="15">15%</option>
        <option value="20">20%</option>
      </select>
    </p>
    <p>
      <anchor>Calculate<go href="tip.wmls#calc()"/></anchor>
    </p>
  </card>

  <card id="tipped" title="Your tip">
    <p>
      Bill: $(bill)<br/>
      Tip ($(pct)%): <b>$(tip)</b><br/>
      Total: <b>$(total)</b>
    </p>
    <p><anchor>Back<prev/></anchor></p>
  </card>

  <card id="quiz" title="WAP quiz">
    <p>What does WML stand for?</p>
    <p>
      <select name="answer" title="Answer">
        <option onpick="#wrong">World Media Language</option>
        <option onpick="#right">Wireless Markup Language</option>
        <option onpick="#wrong">Web Mobile Link</option>
      </select>
    </p>
  </card>

  <card id="right" title="Correct">
    <p><b>Correct!</b> WML is the Wireless Markup Language.</p>
    <p><a href="#home">Home</a></p>
  </card>

  <card id="wrong" title="Not quite">
    <p>Not quite. Try again.</p>
    <p><anchor>Back<prev/></anchor></p>
  </card>

  <!-- A WML timer counts tenths of a second. -->
  <card id="timer" title="Countdown" ontimer="#done">
    <timer value="50"/>
    <p>This card moves on by itself in five seconds, using a WML timer.</p>
  </card>

  <card id="done" title="Done">
    <p>Time's up!</p>
    <p><a href="#home">Home</a></p>
  </card>

  <card id="about" title="About WAP">
    <p>
      WAP, the Wireless Application Protocol, brought the internet to
      mobile phones around the year 2000. Pages were written in WML,
      split into small cards, with two-colour WBMP pictures and
      WMLScript for logic.
    </p>
    <p><a href="#home">Home</a></p>
  </card>
</wml>
